diff --git a/static/css/style.css b/static/css/style.css
index 3361445..59daca4 100644
--- a/static/css/style.css
+++ b/static/css/style.css
@@ -1719,4 +1719,673 @@ select {
     max-height: 380px !important;
     height: 340px !important;
     object-fit: contain !important;
+}
+
+
+/* =========================================================
+   CARTLY - INNER PAGES DESIGN
+   Cart | Checkout | My Orders | Product Details
+   Add this section at the END of style.css
+   ========================================================= */
+
+
+/* =========================================================
+   COMMON INNER PAGE SPACING
+   ========================================================= */
+
+.cart-page,
+.product-detail-page {
+    padding-top: 36px;
+    padding-bottom: 64px;
+}
+
+
+/* =========================================================
+   MY ORDERS PAGE
+   ========================================================= */
+
+.orders-list {
+    display: flex;
+    flex-direction: column;
+    gap: 20px;
+    margin-top: 34px;
+    max-width: 900px;
+}
+
+.order-card {
+    position: relative;
+    padding: 26px 28px;
+    border: 1px solid #e5e7eb;
+    border-radius: 18px;
+    background: #ffffff;
+    box-shadow: 0 8px 24px rgba(17, 17, 17, 0.05);
+    transition: transform 0.25s ease, box-shadow 0.25s ease;
+}
+
+.order-card:hover {
+    transform: translateY(-3px);
+    box-shadow: 0 14px 32px rgba(17, 17, 17, 0.09);
+}
+
+.order-topline {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 16px;
+    padding-bottom: 18px;
+    border-bottom: 1px solid #eeeeee;
+}
+
+.order-topline h3 {
+    margin: 0;
+    font-size: 1.15rem;
+    font-weight: 700;
+    color: #111111;
+}
+
+.order-status {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    padding: 7px 13px;
+    border-radius: 999px;
+    background: #fff3e6;
+    color: #c45b00;
+    font-size: 0.78rem;
+    font-weight: 700;
+    text-transform: capitalize;
+    white-space: nowrap;
+}
+
+.order-meta {
+    display: grid;
+    grid-template-columns: repeat(3, 1fr);
+    gap: 18px;
+    padding: 22px 0;
+}
+
+.order-meta p {
+    margin: 0;
+    color: #6b7280;
+    font-size: 0.9rem;
+    line-height: 1.6;
+}
+
+.order-meta strong {
+    display: block;
+    margin-bottom: 4px;
+    color: #374151;
+    font-size: 0.78rem;
+    text-transform: uppercase;
+    letter-spacing: 0.04em;
+}
+
+.order-actions {
+    display: flex;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 10px;
+    padding-top: 18px;
+    border-top: 1px solid #eeeeee;
+}
+
+.order-actions form {
+    margin: 0;
+}
+
+.order-actions .btn {
+    text-decoration: none;
+    white-space: nowrap;
+}
+
+
+/* Order status variations */
+
+.order-status:empty {
+    display: none;
+}
+
+
+/* =========================================================
+   PRODUCT DETAILS PAGE
+   ========================================================= */
+
+.product-detail-page {
+    max-width: 1180px;
+}
+
+.breadcrumb {
+    display: flex;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 9px;
+    margin-bottom: 30px;
+    color: #6b7280;
+    font-size: 0.88rem;
+}
+
+.breadcrumb a {
+    color: #6b7280;
+    text-decoration: none;
+    transition: color 0.2s ease;
+}
+
+.breadcrumb a:hover {
+    color: #e97800;
+}
+
+.breadcrumb strong {
+    max-width: 260px;
+    overflow: hidden;
+    color: #111111;
+    font-weight: 600;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+}
+
+.product-detail-card {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
+    gap: 56px;
+    align-items: center;
+    padding: 38px;
+    border: 1px solid #e5e7eb;
+    border-radius: 24px;
+    background: #ffffff;
+    box-shadow: 0 12px 36px rgba(17, 17, 17, 0.06);
+}
+
+.product-detail-image {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    min-height: 410px;
+    overflow: hidden;
+    border-radius: 18px;
+    background: #f6f7f9;
+}
+
+.product-detail-image .product-image {
+    display: block;
+    width: 100%;
+    height: 410px;
+    object-fit: contain;
+    mix-blend-mode: multiply;
+    transition: transform 0.35s ease;
+}
+
+.product-detail-image:hover .product-image {
+    transform: scale(1.04);
+}
+
+.product-detail-image .product-image-missing {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    width: 100%;
+    min-height: 410px;
+    color: #9ca3af;
+    font-size: 0.95rem;
+}
+
+.product-detail-info {
+    padding: 8px 0;
+}
+
+.product-detail-info .product-category {
+    display: inline-block;
+    margin-bottom: 14px;
+    color: #e97800;
+    font-size: 0.78rem;
+    font-weight: 700;
+    letter-spacing: 0.1em;
+    text-transform: uppercase;
+}
+
+.product-detail-info h1 {
+    margin: 0 0 22px;
+    color: #111111;
+    font-size: clamp(2rem, 4vw, 3.2rem);
+    font-weight: 750;
+    line-height: 1.12;
+}
+
+.detail-price-row {
+    display: flex;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 16px;
+    margin-bottom: 26px;
+}
+
+.detail-price-row h2 {
+    margin: 0;
+    color: #111111;
+    font-size: 2rem;
+    font-weight: 750;
+}
+
+.product-stock {
+    display: inline-flex;
+    align-items: center;
+    padding: 7px 12px;
+    border-radius: 999px;
+    background: #eaf8ef;
+    color: #18733d;
+    font-size: 0.78rem;
+    font-weight: 700;
+}
+
+.product-stock.out {
+    background: #fff0f0;
+    color: #c62828;
+}
+
+.product-description-full {
+    max-width: 560px;
+    margin: 0 0 30px;
+    color: #6b7280;
+    font-size: 1rem;
+    line-height: 1.9;
+    white-space: pre-line;
+}
+
+.detail-buttons {
+    display: flex;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 12px;
+}
+
+.detail-buttons .btn {
+    min-height: 46px;
+    padding: 13px 22px;
+}
+
+
+/* =========================================================
+   CART PAGE
+   ========================================================= */
+
+.cart-layout {
+    display: grid;
+    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.8fr);
+    align-items: start;
+    gap: 28px;
+    margin-top: 34px;
+}
+
+.cart-items-panel {
+    display: flex;
+    flex-direction: column;
+    gap: 18px;
+}
+
+.cart-item {
+    display: grid;
+    grid-template-columns: 140px minmax(0, 1fr);
+    gap: 22px;
+    padding: 22px;
+    border: 1px solid #e5e7eb;
+    border-radius: 18px;
+    background: #ffffff;
+    box-shadow: 0 6px 20px rgba(17, 17, 17, 0.04);
+}
+
+.cart-item-image {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    min-height: 140px;
+    overflow: hidden;
+    border-radius: 14px;
+    background: #f6f7f9;
+}
+
+.cart-item-image .product-image {
+    width: 100%;
+    height: 140px;
+    object-fit: contain;
+    mix-blend-mode: multiply;
+}
+
+.cart-item-details {
+    display: flex;
+    flex-direction: column;
+    align-items: flex-start;
+}
+
+.cart-item-details .product-category {
+    margin: 0 0 7px;
+    color: #e97800;
+    font-size: 0.73rem;
+    font-weight: 700;
+    letter-spacing: 0.08em;
+    text-transform: uppercase;
+}
+
+.cart-item-details h2 {
+    margin: 0 0 9px;
+    color: #111111;
+    font-size: 1.15rem;
+    line-height: 1.4;
+}
+
+.item-price {
+    margin: 0 0 5px;
+    color: #111111;
+    font-size: 1.05rem;
+    font-weight: 700;
+}
+
+.item-meta {
+    margin: 0 0 16px;
+    color: #6b7280;
+    font-size: 0.88rem;
+}
+
+.quantity-controls {
+    display: inline-flex;
+    align-items: center;
+    gap: 14px;
+    margin-bottom: 16px;
+    padding: 5px 9px;
+    border: 1px solid #e5e7eb;
+    border-radius: 10px;
+    color: #111111;
+    font-weight: 700;
+}
+
+.qty-btn {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    width: 28px;
+    height: 28px;
+    border-radius: 7px;
+    background: #f6f7f9;
+    color: #111111;
+    font-size: 1.1rem;
+    text-decoration: none;
+    transition: background 0.2s ease, color 0.2s ease;
+}
+
+.qty-btn:hover {
+    background: #ff8a00;
+    color: #ffffff;
+}
+
+
+/* =========================================================
+   ORDER SUMMARY
+   ========================================================= */
+
+.order-summary {
+    position: sticky;
+    top: 24px;
+    padding: 28px;
+    border: 1px solid #e5e7eb;
+    border-radius: 20px;
+    background: #ffffff;
+    box-shadow: 0 8px 26px rgba(17, 17, 17, 0.06);
+}
+
+.order-summary h2 {
+    margin: 0 0 24px;
+    color: #111111;
+    font-size: 1.25rem;
+}
+
+.summary-row {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 16px;
+    padding: 14px 0;
+    border-bottom: 1px solid #eeeeee;
+    color: #6b7280;
+    font-size: 0.92rem;
+}
+
+.summary-row strong {
+    color: #374151;
+    text-align: right;
+}
+
+.summary-row.total {
+    margin-top: 8px;
+    padding-top: 20px;
+    border-bottom: 0;
+    color: #111111;
+    font-size: 1.05rem;
+}
+
+.summary-row.total strong {
+    color: #111111;
+    font-size: 1.25rem;
+}
+
+
+/* =========================================================
+   CHECKOUT PAGE
+   ========================================================= */
+
+.checkout-layout {
+    display: grid;
+    grid-template-columns: minmax(0, 1.4fr) minmax(260px, 0.8fr);
+    align-items: start;
+    gap: 30px;
+    width: min(1100px, 100%);
+    margin: 40px auto 64px;
+}
+
+.checkout-card {
+    width: 100%;
+    max-width: none;
+    padding: 34px;
+    border: 1px solid #e5e7eb;
+    border-radius: 22px;
+    background: #ffffff;
+    box-shadow: 0 10px 32px rgba(17, 17, 17, 0.06);
+}
+
+.checkout-card h1 {
+    margin-bottom: 8px;
+}
+
+.checkout-summary {
+    position: static;
+}
+
+.checkout-summary .summary-row strong {
+    font-size: 0.86rem;
+}
+
+
+/* =========================================================
+   RESPONSIVE DESIGN
+   ========================================================= */
+
+@media (max-width: 900px) {
+
+    .product-detail-card {
+        grid-template-columns: 1fr;
+        gap: 30px;
+        padding: 26px;
+    }
+
+    .product-detail-image,
+    .product-detail-image .product-image,
+    .product-detail-image .product-image-missing {
+        min-height: 320px;
+        height: 320px;
+    }
+
+    .cart-layout,
+    .checkout-layout {
+        grid-template-columns: 1fr;
+    }
+
+    .order-summary {
+        position: static;
+    }
+
+    .order-meta {
+        grid-template-columns: repeat(3, 1fr);
+    }
+
+}
+
+@media (max-width: 600px) {
+
+    .order-card {
+        padding: 20px;
+        border-radius: 15px;
+    }
+
+    .order-topline {
+        align-items: flex-start;
+        flex-direction: column;
+        gap: 10px;
+    }
+
+    .order-meta {
+        grid-template-columns: 1fr;
+        gap: 14px;
+    }
+
+    .order-actions {
+        align-items: stretch;
+        flex-direction: column;
+    }
+
+    .order-actions .btn,
+    .order-actions form,
+    .order-actions form .btn {
+        width: 100%;
+    }
+
+    .product-detail-card {
+        padding: 18px;
+        border-radius: 18px;
+    }
+
+    .product-detail-info h1 {
+        font-size: 2rem;
+    }
+
+    .detail-price-row h2 {
+        font-size: 1.6rem;
+    }
+
+    .detail-buttons {
+        align-items: stretch;
+        flex-direction: column;
+    }
+
+    .detail-buttons .btn {
+        width: 100%;
+        text-align: center;
+    }
+
+    .cart-item {
+        grid-template-columns: 1fr;
+        gap: 18px;
+        padding: 16px;
+    }
+
+    .cart-item-image,
+    .cart-item-image .product-image {
+        height: 190px;
+        min-height: 190px;
+    }
+
+    .cart-item-details h2 {
+        font-size: 1rem;
+    }
+
+    .order-summary,
+    .checkout-card {
+        padding: 22px;
+    }
+
+    
+/* =========================================================
+   MY ORDERS - IMPROVED ACTION BUTTONS
+   ========================================================= */
+
+.order-actions {
+    display: flex;
+    align-items: center;
+    flex-wrap: wrap;
+    gap: 10px;
+}
+
+.order-actions .btn {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    min-height: 40px;
+    padding: 10px 16px;
+    border-radius: 9px;
+    font-size: 0.8rem;
+    font-weight: 700;
+    text-decoration: none;
+    cursor: pointer;
+    transition: all 0.2s ease;
+}
+
+.order-actions .btn-secondary {
+    background: #111111;
+    border: 1px solid #111111;
+    color: #ffffff;
+}
+
+.order-actions .btn-secondary:hover {
+    background: #333333;
+    border-color: #333333;
+    transform: translateY(-2px);
+}
+
+.order-actions .btn-danger {
+    background: #fff1f1;
+    border: 1px solid #ffd2d2;
+    color: #c62828;
+}
+
+.order-actions .btn-danger:hover {
+    background: #c62828;
+    border-color: #c62828;
+    color: #ffffff;
+    transform: translateY(-2px);
+}
+
+.order-actions .btn-outline {
+    background: #ffffff;
+    border: 1px solid #e97800;
+    color: #d86600;
+}
+
+.order-actions .btn-outline:hover {
+    background: #e97800;
+    border-color: #e97800;
+    color: #ffffff;
+    transform: translateY(-2px);
+}
+
+.order-actions form {
+    display: inline-flex;
+    margin: 0;
+}
+
+@media (max-width: 600px) {
+    .order-actions .btn,
+    .order-actions form,
+    .order-actions form .btn {
+        width: 100%;
+    }
+}
+
+
+
 }
\ No newline at end of file
